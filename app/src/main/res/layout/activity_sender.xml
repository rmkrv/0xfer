<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:id="@+id/sender_navigation"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/sender_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Go back"
            android:padding="10dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Send"
            android:textColor="@color/app_on_surface"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sender_status_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_soft_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="13dp"
        android:paddingEnd="16dp"
        android:paddingBottom="13dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_live_indicator" />

        <TextView
            android:id="@+id/sender_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Choose something to send."
            android:textColor="@color/app_on_primary_soft"
            android:textSize="14sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/sender_setup_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/sender_choice_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What would you like to send?"
            android:textColor="@color/app_on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="One file or message at a time."
            android:textColor="@color/app_on_surface_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sender_pick"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="74dp"
                android:layout_weight="1"
                android:backgroundTint="@color/app_surface"
                android:text="File"
                android:textColor="@color/app_primary"
                app:cornerRadius="22dp"
                app:icon="@drawable/ic_file"
                app:iconGravity="textTop"
                app:iconPadding="5dp"
                app:iconTint="@color/app_primary"
                app:strokeColor="@color/app_outline"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sender_choose_text"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="74dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:backgroundTint="@color/app_surface"
                android:text="Text"
                android:textColor="@color/app_primary"
                app:cornerRadius="22dp"
                app:icon="@drawable/ic_text"
                app:iconGravity="textTop"
                app:iconPadding="5dp"
                app:iconTint="@color/app_primary"
                app:strokeColor="@color/app_outline"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/sender_text_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="Message to send"
            android:visibility="gone"
            app:boxBackgroundColor="@color/app_surface"
            app:boxCornerRadiusBottomEnd="20dp"
            app:boxCornerRadiusBottomStart="20dp"
            app:boxCornerRadiusTopEnd="20dp"
            app:boxCornerRadiusTopStart="20dp"
            app:boxStrokeColor="@color/app_primary">

            <EditText
                android:id="@+id/sender_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:textColor="@color/app_on_surface"
                android:textColorHint="@color/app_on_surface_muted"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/sender_transfer_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_soft_panel"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Transfer settings"
                android:textColor="@color/app_on_primary_soft"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="QR version"
                        android:textColor="@color/app_on_primary_soft"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/sender_version"
                        android:layout_width="match_parent"
                        android:layout_height="44dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Speed"
                        android:textColor="@color/app_on_primary_soft"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/sender_fps"
                        android:layout_width="match_parent"
                        android:layout_height="44dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Code layout"
                android:textColor="@color/app_on_primary_soft"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/sender_grid"
                android:layout_width="match_parent"
                android:layout_height="44dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Experimental code type"
                android:textColor="@color/app_on_primary_soft"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/sender_code_type"
                android:layout_width="match_parent"
                android:layout_height="44dp" />
        </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sender_start"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="22dp"
        android:backgroundTint="@color/app_primary"
        android:enabled="false"
        android:text="Show transfer code"
        android:textColor="@color/app_on_primary"
        android:textSize="16sp"
        app:cornerRadius="20dp" />

    <LinearLayout
        android:id="@+id/sender_qr_information"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Let the other phone scan this moving code."
            android:textColor="@color/app_on_surface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="Tap the code to make it full screen."
            android:textColor="@color/app_on_surface_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/sender_qr_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:background="@color/app_qr_surface"
        android:visibility="gone">

        <com.android.xfer.qr.QrDisplayView
            android:id="@+id/sender_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/app_qr_surface" />

        <com.android.xfer.hcc2d.Hcc2dDisplayView
            android:id="@+id/sender_hcc2d_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/app_qr_surface"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/sender_bottom_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Keep this screen bright for the best transfer."
        android:textColor="@color/app_on_surface_muted"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
