<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <com.android.xfer.qr.ParallelCameraView
        android:id="@+id/receiver_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.android.xfer.hcc2d.Hcc2dCameraView
        android:id="@+id/receiver_hcc2d_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.android.xfer.receiver.QROverlayView
        android:id="@+id/receiver_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="76dp"
        android:background="@drawable/bg_camera_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="13dp"
        android:paddingEnd="16dp"
        android:paddingBottom="13dp">

        <View
            android:id="@+id/receiver_activity_indicator"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:background="@drawable/bg_live_indicator" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/receiver_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Looking for a transfer…"
                android:textColor="@color/app_on_camera"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/receiver_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="8dp"
                android:indeterminate="false"
                android:max="100"
                android:progressBackgroundTint="@color/app_camera_control"
                android:progressTint="@color/app_primary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/receiver_benchmark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:textColor="@color/app_on_camera"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/receiver_switch_camera"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_camera_control"
        android:contentDescription="Switch camera"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_camera"
        android:tint="@color/app_on_camera" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="30dp"
        android:gravity="center"
        android:text="Point your camera at the moving code"
        android:textColor="@color/app_on_camera"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/receiver_debug"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/receiver_result"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_background"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="68dp"
            android:paddingEnd="24dp"
            android:paddingBottom="30dp">

            <FrameLayout
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_brand_mark">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check" />
            </FrameLayout>

            <TextView
                android:id="@+id/result_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="Transfer complete"
                android:textColor="@color/app_on_surface"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/result_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/app_on_surface_muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/result_sha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_soft_panel"
                android:gravity="center"
                android:padding="14dp"
                android:textColor="@color/app_on_primary_soft"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/result_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_surface_panel"
                android:padding="16dp"
                android:textColor="@color/app_on_surface"
                android:textIsSelectable="true"
                android:textSize="15sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/result_save"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="28dp"
                android:backgroundTint="@color/app_primary"
                android:text="Save to Downloads"
                android:textColor="@color/app_on_primary"
                app:cornerRadius="20dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/result_share"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/app_surface"
                    android:text="Share"
                    android:textColor="@color/app_primary"
                    app:cornerRadius="19dp"
                    app:strokeColor="@color/app_outline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/result_open"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/app_surface"
                    android:text="Open"
                    android:textColor="@color/app_primary"
                    app:cornerRadius="19dp"
                    app:strokeColor="@color/app_outline" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/result_rescan"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="Receive another transfer"
                android:textColor="@color/app_primary" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
